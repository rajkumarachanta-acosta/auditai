# PostgreSQL connection string used by Prisma (see prisma.config.ts + lib/reachy/db.ts)
DATABASE_URL="postgresql://user:password@localhost:5432/reachy?schema=public"

# Auth.js
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI — used for pain point extraction, scoring, and report summaries
OPENAI_API_KEY=""

# Resend — weekly / on-demand report emails
RESEND_API_KEY=""
REACHY_REPORT_FROM_EMAIL="reachy@your-domain.com"

# Bearer token required on /api/reachy/cron/* routes (set as Vercel Cron header)
CRON_SECRET=""
